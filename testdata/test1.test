disable
run testdata/LDA.6502
assert @1000 $01
assert @1001 $02
assert @1002 $03
assert @1003 $04
assert @1004 $05
assert @1005 $06
assert @1006 $07
assert @1007 $08

run testdata/STA.6502
assert @10 $01
assert @11 $02
assert @1000 $03
assert @1001 $04
assert @1002 $05
assert @1003 $06
assert @1004 $07

run testdata/INC.6502
assert @10 $11
assert @11 $21
assert @1000 $31
assert @1001 $41

run testdata/DEC.6502
assert @10 $0F
assert @11 $1F
assert @1000 $2F
assert @1001 $3F

run testdata/DEX.6502
assert X $0F

run testdata/INX.6502
assert X $11

run testdata/DEY.6502
assert Y $0F

run testdata/INY.6502
assert Y $11

run testdata/ADC.6502
assert @1000 $30
assert @1001 $31
assert @1002 $32
assert @1003 $33
assert @1004 $34
assert @1005 $35
assert @1006 $36
assert @1007 $37
assert @1008 $31

run testdata/CLC.6502
assert @1000 $31
assert @1001 $30

run testdata/AND.6502
assert @1000 $00
assert @1001 %00000001
assert @1002 %00000001
assert @1003 %00000011
assert @1004 %00000001
assert @1005 %00000101
assert @1006 %00001001
assert @1007 %00010001
assert @1008 %00100001

run testdata/JMP.6502
assert @0020 $10
assert @0021 $20

enable
run testdata/ASL.6502
assert @1000 %01010100
assert @1001 $31
assert @1002 $00
assert @1003 $31
assert @1004 %10000000
assert @1005 $30
assert @0030 $02
assert @0031 $02
assert @1010 $04
assert @1011 $04
