; test ASL

; implied (with carry flag)
LDA #%10101010
ASL A
STA $1000
LDA #$10
ADC #$20
STA $1001

; implied (with carry flag and zero flag)
CLC
LDA #%10000000
ASL A
STA $1002
LDA #$10
ADC #$20
STA $1003


; implied (without carry flag and wirh negative flag)
CLC
LDA #%01000000
ASL A
STA $1004
LDA #$10
ADC #$20
STA $1005

; zeropage
LDA #%00000001
STA $30
ASL $30

; zeropage indexed by X
LDA #%00000001
STA $31
LDX #$01
ASL $30,X

; absolute
LDA #%00000010
STA $1010
ASL $1010

; zeropage indexed by X
LDA #%00000010
STA $1011
LDX #$01
ASL $1010,X
